VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- 디데이 알림 (Web Push) ---
# VAPID 키 쌍 생성: npx web-push generate-vapid-keys
# 공개 키는 두 곳에 같은 값을 넣는다 — 브라우저가 구독할 때(VITE_)와 서버가
# 서명할 때 모두 필요하다. 값이 어긋나면 발송이 조용히 실패한다.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 생겼을 때 연락할 주소. mailto: 형식이어야 한다.
VAPID_SUBJECT=mailto:you@example.com

# 발송 함수(api/notify-dday.ts)는 모든 커플의 구독을 읽어야 해서 RLS를 우회한다.
# 절대 VITE_ 접두사를 붙이지 말 것 — 붙이면 클라이언트 번들에 그대로 실린다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron이 발송 엔드포인트를 부를 때 쓰는 비밀값. 긴 랜덤 문자열이면 된다.
# 설정하지 않으면 엔드포인트가 401만 돌려주고 알림은 나가지 않는다.
CRON_SECRET=
