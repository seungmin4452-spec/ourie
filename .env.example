VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- 디데이 알림 (Web Push) ---
# VAPID 키 쌍 생성: npx web-push generate-vapid-keys
# 공개 키는 두 곳에 같은 값을 넣는다 — 브라우저가 구독할 때(VITE_)와 서버가
# 서명할 때 모두 필요하다. 값이 어긋나면 발송이 조용히 실패한다.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 생겼을 때 연락할 주소. mailto: 형식이어야 한다.
VAPID_SUBJECT=mailto:you@example.com

# 발송 함수(api/notify-dday.ts)는 모든 커플의 구독을 읽어야 해서 RLS를 우회한다.
# 절대 VITE_ 접두사를 붙이지 말 것 — 붙이면 클라이언트 번들에 그대로 실린다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 스케줄러가 발송 엔드포인트를 부를 때 쓰는 비밀값. 긴 랜덤 문자열이면 된다.
# 설정하지 않으면 엔드포인트가 401만 돌려주고 알림은 나가지 않는다.
#
# **같은 값을 Supabase Vault에도 'cron_secret'이라는 이름으로 넣어야 한다.**
# 엔드포인트를 부르는 쪽이 Vercel Cron이 아니라 Supabase의 pg_cron이라, 여기
# 값만 바꾸면 다음 날 아침에 401로 조용히 실패한다
# (supabase/migrations/2026-08-12-notify-cron.sql 머리말 참고).
CRON_SECRET=

# AI 아바타 위젯 — 커플 둘이 공용으로 쓰는 Puter 계정의 개인 액세스 토큰
# (puter.com 로그인 후 Account 설정 -> API 토큰에서 발급). 이미지 생성 자체는
# 서버가 아니라 브라우저에서 나가지만(Node 런타임에 미해결 버그가 있어서다,
# src/features/aiAvatar/hooks/useGenerateAiAvatar.ts 참고), 토큰을 클라이언트
# 번들에 그대로 박아두면 로그인 여부와 무관하게 그 URL에 접속하는 누구나
# 뽑아갈 수 있으므로 api/puter-token.ts가 로그인한 사용자에게만 내려준다.
# 절대 VITE_ 접두사를 붙이지 말 것.
PUTER_SHARED_TOKEN=
